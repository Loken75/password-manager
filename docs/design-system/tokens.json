{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Source de vérité unique des design tokens — direction « Expressif & moderne ». Trois niveaux : primitive (valeurs brutes), semantic (intentions, déclinées light/dark), component (portée composant). Génère le thème FlatLaf (desktop) et le thème Compose (Android). Ne JAMAIS coder une valeur en dur dans l'UI : passer par un token sémantique ou composant.",
  "$meta": {
    "version": "1.0.0",
    "direction": "expressive-modern",
    "accentSeed": "#4F46E5",
    "grid": 8,
    "wcag": "2.2 AA (texte 4.5:1, large 3:1, UI/graphique 3:1)"
  },

  "primitive": {
    "color": {
      "accent": {
        "10": "#1E1B4B",
        "20": "#312E81",
        "30": "#3730A3",
        "40": "#4F46E5",
        "50": "#6366F1",
        "60": "#818CF8",
        "70": "#A5B4FC",
        "80": "#C7D2FE",
        "90": "#E0E7FF",
        "95": "#EEF2FF"
      },
      "neutral": {
        "0": "#FFFFFF",
        "5": "#F7F7FB",
        "10": "#EEEEF4",
        "20": "#D9D9E3",
        "30": "#BFBFCC",
        "40": "#9595A3",
        "50": "#71717F",
        "60": "#52525E",
        "70": "#3A3A44",
        "80": "#2A2A33",
        "90": "#1A1A20",
        "95": "#141418",
        "100": "#111116"
      },
      "green": { "40": "#15803D", "50": "#16A34A", "60": "#22C55E", "90": "#DCFCE7" },
      "amber": { "40": "#B45309", "50": "#F59E0B", "60": "#FBBF24", "90": "#FEF3C7" },
      "red":   { "40": "#B91C1C", "50": "#DC2626", "60": "#EF4444", "90": "#FEE2E2" },
      "category": {
        "indigo": "#6366F1",
        "teal":   "#14B8A6",
        "rose":   "#F43F5E",
        "amber":  "#F59E0B",
        "violet": "#A855F7",
        "cyan":   "#06B6D4",
        "lime":   "#84CC16",
        "orange": "#F97316",
        "sky":    "#0EA5E9",
        "slate":  "#64748B"
      }
    },
    "space": { "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 24, "7": 32, "8": 48, "9": 64 },
    "radius": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "full": 9999 },
    "size": {
      "touchTarget": 48,
      "touchTargetMin": 44,
      "icon": 24,
      "iconSmall": 20,
      "avatar": 40,
      "fab": 56,
      "strengthBar": 6,
      "focusRing": 2
    },
    "font": {
      "family": {
        "sans": "Inter, 'SF Pro', Roboto, 'Segoe UI', system-ui, sans-serif",
        "mono": "'JetBrains Mono', 'SF Mono', 'Roboto Mono', Consolas, monospace"
      },
      "size":   { "display": 36, "headline": 28, "title": 22, "titleSm": 16, "body": 16, "bodySm": 14, "label": 12, "labelSm": 11 },
      "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "lineHeight": { "display": 44, "headline": 36, "title": 28, "titleSm": 24, "body": 24, "bodySm": 20, "label": 16 }
    },
    "motion": {
      "duration": { "instant": 0, "fast": 150, "base": 200, "emphasized": 300, "large": 375 },
      "easing": {
        "standard":   [0.4, 0.0, 0.2, 1.0],
        "decelerate": [0.0, 0.0, 0.2, 1.0],
        "accelerate": [0.4, 0.0, 1.0, 1.0],
        "sharp":      [0.4, 0.0, 0.6, 1.0]
      },
      "spring": {
        "standard":   { "dampingRatio": 0.9, "stiffness": 700 },
        "expressive": { "dampingRatio": 0.6, "stiffness": 500 }
      }
    },
    "elevation": {
      "level0": { "y": 0, "blur": 0, "opacity": 0.0 },
      "level1": { "y": 1, "blur": 3, "opacity": 0.10 },
      "level2": { "y": 2, "blur": 8, "opacity": 0.12 },
      "level3": { "y": 6, "blur": 16, "opacity": 0.14 }
    }
  },

  "semantic": {
    "light": {
      "color.surface":            "{primitive.color.neutral.0}",
      "color.surface.container":  "{primitive.color.neutral.5}",
      "color.surface.elevated":   "{primitive.color.neutral.0}",
      "color.surface.sunken":     "{primitive.color.neutral.10}",
      "color.outline":            "{primitive.color.neutral.20}",
      "color.outline.subtle":     "{primitive.color.neutral.10}",
      "color.accent":             "{primitive.color.accent.40}",
      "color.accent.onAccent":    "{primitive.color.neutral.0}",
      "color.accent.container":   "{primitive.color.accent.95}",
      "color.accent.onContainer": "{primitive.color.accent.20}",
      "color.text.primary":       "{primitive.color.neutral.100}",
      "color.text.secondary":     "{primitive.color.neutral.50}",
      "color.text.onSecret":      "{primitive.color.neutral.100}",
      "color.text.disabled":      "{primitive.color.neutral.40}",
      "color.status.strong":      "{primitive.color.green.50}",
      "color.status.strong.text": "{primitive.color.green.40}",
      "color.status.medium":      "{primitive.color.amber.50}",
      "color.status.medium.text": "{primitive.color.amber.40}",
      "color.status.weak":        "{primitive.color.red.50}",
      "color.status.weak.text":   "{primitive.color.red.40}",
      "color.status.onStatus":    "{primitive.color.neutral.0}",
      "color.favorite":           "{primitive.color.amber.50}"
    },
    "dark": {
      "color.surface":            "{primitive.color.neutral.95}",
      "color.surface.container":  "{primitive.color.neutral.90}",
      "color.surface.elevated":   "{primitive.color.neutral.80}",
      "color.surface.sunken":     "{primitive.color.neutral.100}",
      "color.outline":            "{primitive.color.neutral.70}",
      "color.outline.subtle":     "{primitive.color.neutral.80}",
      "color.accent":             "{primitive.color.accent.60}",
      "color.accent.onAccent":    "{primitive.color.neutral.100}",
      "color.accent.container":   "{primitive.color.accent.20}",
      "color.accent.onContainer": "{primitive.color.accent.90}",
      "color.text.primary":       "{primitive.color.neutral.5}",
      "color.text.secondary":     "{primitive.color.neutral.40}",
      "color.text.onSecret":      "{primitive.color.neutral.5}",
      "color.text.disabled":      "{primitive.color.neutral.50}",
      "color.status.strong":      "{primitive.color.green.60}",
      "color.status.strong.text": "{primitive.color.green.60}",
      "color.status.medium":      "{primitive.color.amber.60}",
      "color.status.medium.text": "{primitive.color.amber.60}",
      "color.status.weak":        "{primitive.color.red.60}",
      "color.status.weak.text":   "{primitive.color.red.60}",
      "color.status.onStatus":    "{primitive.color.neutral.100}",
      "color.favorite":           "{primitive.color.amber.60}"
    },
    "shared": {
      "space.cardGap":     "{primitive.space.5}",
      "space.cardPadding": "{primitive.space.5}",
      "space.screenEdge":  "{primitive.space.5}",
      "space.fieldGap":    "{primitive.space.4}",
      "space.sectionGap":  "{primitive.space.6}",
      "radius.button":     "{primitive.radius.md}",
      "radius.input":      "{primitive.radius.md}",
      "radius.card":       "{primitive.radius.lg}",
      "radius.sheet":      "{primitive.radius.xl}",
      "radius.chip":       "{primitive.radius.full}"
    }
  },

  "component": {
    "entryCard": {
      "padding":      "{semantic.shared.space.cardPadding}",
      "radius":       "{semantic.shared.radius.card}",
      "gap":          "{primitive.space.3}",
      "avatarSize":   "{primitive.size.avatar}",
      "strengthBarWidth": "{primitive.size.strengthBar}"
    },
    "bentoCard": {
      "radius":  "{semantic.shared.radius.card}",
      "padding": "{primitive.space.6}",
      "gap":     "{semantic.shared.space.cardGap}",
      "minWidth": 220
    },
    "secretField": {
      "fontFamily": "{primitive.font.family.mono}",
      "radius":     "{semantic.shared.radius.input}",
      "revealAutoHideMs": 30000
    },
    "button": {
      "radius":      "{semantic.shared.radius.button}",
      "minHeight":   "{primitive.size.touchTarget}",
      "focusRing":   "{primitive.size.focusRing}"
    },
    "statusBadge": {
      "radius": "{primitive.radius.full}",
      "paddingX": "{primitive.space.3}",
      "paddingY": "{primitive.space.1}"
    },
    "strengthMeter": {
      "height": "{primitive.size.strengthBar}",
      "radius": "{primitive.radius.full}"
    }
  }
}
